@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = null;
    var pageTitle = ViewBag.Title as string ?? "Portfolio";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@pageTitle</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div class="app-shell">

        @await Html.PartialAsync("~/Views/Partials/Layout/_Header.cshtml")

        <main class="site-main" role="main">
            <div class="main-inner">
                @RenderBody()
            </div>
        </main>

        @await Html.PartialAsync("~/Views/Partials/Layout/_Footer.cshtml")

    </div>

    @RenderSection("Scripts", required: false)
</body>
</html>
