@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Web.Common.PublishedModels
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<object>

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    @await Html.PartialAsync("~/Views/Partials/Layout/_SeoMeta.cshtml", Model)
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div class="app-shell">

        @await Html.PartialAsync("~/Views/Partials/Layout/_Header.cshtml", Model)

        <main class="site-main" role="main">
            <div class="main-inner">
                @RenderBody()
            </div>
        </main>

        @await Html.PartialAsync("~/Views/Partials/Layout/_Footer.cshtml", Model)

    </div>

    @await Html.PartialAsync("~/Views/Partials/Layout/_CookieConsent.cshtml", Model)

    @RenderSection("Scripts", required: false)
</body>
</html>
