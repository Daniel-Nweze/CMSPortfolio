@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@using System.Linq
@using System.Collections.Generic
@using System.Globalization
@using Umbraco.Cms.Core.Models.PublishedContent
@using Umbraco.Extensions

@{
    var currentPage = Model as IPublishedContent;
    var root = currentPage?.Root();

    var navItems = root?.Children?
        .Where(x => x.IsVisible()
                    && x.ContentType.Alias != "searchPage"
                    && x.ContentType.Alias != "errorPage")
        .OrderBy(x => x.SortOrder)
        .ToList() ?? new List<IPublishedContent>();

    var currentUrl = currentPage?.Url();

    // --- Språkinfo ---
    var currentCultureName = CultureInfo.CurrentUICulture.Name; // t.ex. "sv-SE" eller "en-US"
    var isSv = currentCultureName.StartsWith("sv", StringComparison.OrdinalIgnoreCase);
    var isEn = currentCultureName.StartsWith("en", StringComparison.OrdinalIgnoreCase);

    // Försök att länka till samma sida i andra språket, annars fall back till root
    var svUrl = currentPage?.Url("sv-SE")
                ?? root?.Url("sv-SE")
                ?? "/";

    var enUrl = currentPage?.Url("en-US")
                ?? root?.Url("en-US")
                ?? "/en/";

    // Dictionary för sök-placeholder (läggs till strax i backoffice)
    var culture = isSv ? new CultureInfo("sv-SE") : new CultureInfo("en-US");

    var searchPlaceholder =
        Umbraco.GetDictionaryValue("SearchPlaceholder", culture)
        ?? (isSv ? "Sök..." : "Search...");

    var searchPage = root?
             .Children
             .FirstOrDefault(x => x.ContentType.Alias == "searchPage");

    var searchUrl = searchPage?.Url() ?? "#";
}


<header class="site-header" role="banner">
    <div class="site-header-inner">
        <a href="@root?.Url()" class="brand">
            <div class="brand-mark"></div>
            <div class="brand-text">
                <span>NWEZE</span>
                <span>Portfolio</span>
            </div>
        </a>

        <nav class="main-nav" role="navigation" aria-label="Main navigation">
            <div class="nav-links">
                @foreach (var item in navItems)
                {
                    var itemUrl = item.Url();
                    var isActive = currentUrl != null && currentUrl.StartsWith(itemUrl);

                    <a href="@itemUrl" class="nav-link @(isActive ? "active" : "")">
                        @item.Name
                    </a>
                }
            </div>

            <div class="header-tools">
                <div class="lang-switch" aria-label="Language switcher">
                    <a href="@svUrl" class="@(isSv ? "active" : "")">SV</a>
                    <span>/</span>
                    <a href="@enUrl" class="@(isEn ? "active" : "")">EN</a>
                </div>

                <form method="get" action="@searchUrl" class="header-search">
                    <input type="search"
                           name="q"
                           placeholder=@searchPlaceholder
                           class="header-search__input" />
                </form>


            </div>
        </nav>
    </div>
</header>
