@using System.Globalization
@using Umbraco.Cms.Core.Models
@using Umbraco.Cms.Core.Models.PublishedContent
@using Umbraco.Extensions
@using CMSPortfolio.Models.Viewmodels
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<object>

@{
    IPublishedContent? content = null;

    switch (Model)
    {
        case IPublishedContent ip:
            content = ip;
            break;

        case ContentModel cm:
            content = cm.Content;
            break;

        case PortfolioPageViewModel vm:
            content = vm.Page;
            break;
    }

    var siteName = "Nweze Portfolio";

    if (content == null)
    {
        var fallbackTitle = siteName;
        <title>@fallbackTitle</title>
        // Ingen mer SEO om vi inte vet vilken sida det är.
        return;
    }

    var seoTitle = content.Value<string>("seoTitle");
    var seoMetaDescription = content.Value<string>("seoMetaDescription");
    var seoCanonicalUrl = content.Value<string>("seoCanonicalUrl");
    var seoImage = content.Value<IPublishedContent>("seoImage");
    var metaRobots = content.Value<string>("metaRobots");

    var pageTitle = !string.IsNullOrWhiteSpace(seoTitle)
        ? seoTitle
        : content.Name;

    var fullTitle = $"{pageTitle} | {siteName}";

    var baseUrl = $"{Context.Request.Scheme}://{Context.Request.Host}".TrimEnd('/');
    var relativeUrl = content.Url();

    var canonicalUrl = !string.IsNullOrWhiteSpace(seoCanonicalUrl)
        ? seoCanonicalUrl.Trim()
        : baseUrl + relativeUrl;

    var robotsValue = !string.IsNullOrWhiteSpace(metaRobots)
        ? metaRobots
        : "index,follow";

    var culture = CultureInfo.CurrentUICulture;
    var ogLocale = culture.Name.Replace('-', '_');
}

<title>@fullTitle</title>

@if (!string.IsNullOrWhiteSpace(seoMetaDescription))
{
    <meta name="description" content="@seoMetaDescription" />
}

<meta name="robots" content="@robotsValue" />
<link rel="canonical" href="@canonicalUrl" />

<meta property="og:title" content="@fullTitle" />
@if (!string.IsNullOrWhiteSpace(seoMetaDescription))
{
    <meta property="og:description" content="@seoMetaDescription" />
}
<meta property="og:url" content="@canonicalUrl" />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="@siteName" />
<meta property="og:locale" content="@ogLocale" />

@if (seoImage != null)
{
    var ogImageUrl = seoImage.Url(mode: UrlMode.Absolute);
    <meta property="og:image" content="@ogImageUrl" />
}
