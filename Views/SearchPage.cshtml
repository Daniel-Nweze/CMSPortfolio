@using System.Collections.Generic
@using Examine
@using Umbraco.Cms.Core
@using Umbraco.Cms.Core.Models.PublishedContent
@using Umbraco.Cms.Core.Web
@using Umbraco.Cms.Web.Common
@using Umbraco.Extensions
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@using System.Globalization




@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage

@inject IExamineManager ExamineManager
@inject IUmbracoContextFactory UmbracoContextFactory

@{
    Layout = "layout.cshtml";

    // Redaktörsstyrd introtext från doctype (SearchPage)
    var introText = Model.Value<string>("introText");

    // query från ?q= i URL:en
    var query = (Context.Request.Query["q"].ToString() ?? string.Empty).Trim();
    var hasQuery = !string.IsNullOrWhiteSpace(query);

    var culture = CultureInfo.CurrentUICulture;
    var isSv = culture.TwoLetterISOLanguageName.Equals("sv", StringComparison.OrdinalIgnoreCase);

    var searchPlaceholder =
        Umbraco.GetDictionaryValue("SearchPage.Placeholder", culture)
        ?? (isSv ? "Sök efter innehåll..." : "Search content...");

    var searchButtonLabel =
        Umbraco.GetDictionaryValue("SearchPage.ButtonLabel", culture)
        ?? (isSv ? "Sök" : "Search");


    var currentRoot = Model.Root();
    var currentRootKey = currentRoot?.Key;

    var results = new List<IPublishedContent>();

    if (hasQuery && ExamineManager.TryGetIndex(Constants.UmbracoIndexes.ExternalIndexName, out var index))
    {
        var searcher = index.Searcher;

        // Enkel "managed" text-sökning
        var examineQuery = searcher
            .CreateQuery("content")
            .ManagedQuery(query);

        var searchResults = examineQuery.Execute();

        using var cref = UmbracoContextFactory.EnsureUmbracoContext();
        var contentCache = cref.UmbracoContext.Content;

        foreach (var item in searchResults)
        {
            if (!int.TryParse(item.Id, out var nodeId))
                continue;

            var content = contentCache.GetById(nodeId);
            if (content == null)
                continue;

            var root = content.Root();
            if (root == null || root.Key != currentRootKey)
                continue; // filtrera bort andra språk/webbplatser

            var alias = content.ContentType.Alias;

            // Begränsa till dina relevanta sidtyper
            if (alias is "homePage"
                     or "aboutPage"
                     or "skillsPage"
                     or "portfolioPage"
                     or "referencesPage"
                     or "contactPage"
                     or "portfolioItem")
            {
                results.Add(content);
            }
        }
    }

    var count = results.Count;
}

<section class="search-page">
    <div class="container">
        <header class="search-page__header">
            <h1>@Model.Name</h1>

            <form method="get" action="@Model.Url()" class="search-page__form">
                <input type="search"
                       name="q"
                       value="@query"
                       placeholder="@searchPlaceholder"
                       class="search-input" />
                <button type="submit" class="btn btn-primary">@searchButtonLabel</button>

            </form>
        </header>

        @if (!hasQuery)
        {
            if (!string.IsNullOrWhiteSpace(introText))
            {
                <div class="search-page__info">
                    @Html.Raw(introText)
                </div>
            }
            else
            {
                <p class="search-page__info">
                    Skriv något i sökfältet och tryck på Sök.
                </p>
            }
        }
        else if (count == 0)
        {
            <p class="search-page__info">
                Inga träffar för "<strong>@query</strong>".
            </p>
        }
        else
        {
            <p class="search-page__info">
                @count träff@(count == 1 ? "" : "ar") för "<strong>@query</strong>".
            </p>

            <ul class="search-page__results">
                @foreach (var node in results)
                {
                    <li class="search-result">
                        <a href="@node.Url()" class="search-result__title">
                            @node.Name
                        </a>
                        <div class="search-result__meta">
                            @node.ContentType.Alias
                        </div>
                    </li>
                }
            </ul>
        }
    </div>
</section>
