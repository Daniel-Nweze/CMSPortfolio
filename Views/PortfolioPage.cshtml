<section class="page-section portfolio-section">
    <div class="page-container">
        <h1>@Model.Page.Name</h1>

        @* Om du har ett rich text-fält senare:
           @Model.Page.Value("bodyTextAlias")
        *@

        <h2 class="section-heading">Latest GitHub projects</h2>

        @if (Model.GitHubRepositories.Any())
        {
            <div class="repo-grid">
                @foreach (var repo in Model.GitHubRepositories)
                {
                    <article class="repo-card">
                        <h3>
                            <a href="@repo.HtmlUrl" target="_blank" rel="noopener">
                                @repo.Name
                            </a>
                        </h3>

                        <p class="repo-description">
                            @(!string.IsNullOrWhiteSpace(repo.Description)
                                                ? repo.Description
                                                : "No description provided.")
                </p>

                        <div class="repo-meta">
                            <span>@repo.Language</span>
                            <span>@repo.Stars ★</span>
                            <span>@repo.LastPushDate.ToLocalTime().ToString("yyyy-MM-dd")</span>
                        </div>
                    </article>
                        }
            </div>
        }
        else
        {
            <p>No public repositories could be loaded right now.</p>
        }
    </div>
</section>
